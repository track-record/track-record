# Copy this file to secrets.properties (it is git-ignored) and fill in your own values. They are
# built into the app as defaults; users can still enter their own in Settings. Empty or missing values
# leave AcoustID fingerprinting / MusicBrainz lookups off until set in Settings (DECISIONS.md D-177).
#
# An AcoustID application key: register at https://acoustid.org/new-application
acoustid.key=
# A contact address MusicBrainz can reach you at; sent in the User-Agent of every request.
musicbrainz.contact=
# Optional: where your published guest page is (tools/publish_pages.py), for internet invites.
# guest.page=https://<your-org>.github.io/
